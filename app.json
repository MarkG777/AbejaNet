{
  "expo": {
    "name": "AbejaNet",
    "slug": "AbejaNet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_abejanet_sin_letras.png",
    "scheme": "com.markg777.AbejaNet",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo_abejanet_sin_letras.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.markg777.AbejaNet",
      "usesCleartextTraffic": true,
      "googleServicesFile": "./google-services.json",
      "notification": {
        "icon": "./assets/images/pruebados.png",
        "color": "#F9A825"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "image": "./assets/images/logo_abejanet_sin_letras.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFCC3C"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_abejanet_sin_letras.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFCC3C"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "API_BASE_URL": "https://abejanet-backend.onrender.com",
      "googleAuth": {
        "iosClientId": "388995501406-iol2mrvtv0m6akccnm9n5q850chdv17r.apps.googleusercontent.com",
        "androidClientId": "388995501406-nmqjel504l0lkrg8lkufjlkgofd5vbea.apps.googleusercontent.com",
        "androidClientIdDebug": "388995501406-r0d70mv0vobj8tistbejalp5nq15u413.apps.googleusercontent.com",
        "webClientId": "388995501406-ki4qnr91kifk0e5emvj6o0pdnc1s66e9.apps.googleusercontent.com"
      },
      "eas": {
        "projectId": "c37ef698-5280-4fba-bd24-5a60024ea405"
      },
      "NEWS_API_KEY": "7c6213688f3b443885452ce426874d51"
    },
    "owner": "marcoexpo123"
  }
}
