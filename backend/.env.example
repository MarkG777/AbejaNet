# ================================================================
# EJEMPLO DE VARIABLES DE ENTORNO PARA ABEJANET BACKEND
# ================================================================
# Copia este archivo a .env y completa con tus valores reales

# === BASE DE DATOS ===
DATABASE_URL=postgresql://usuario:password@host/database

# === SEGURIDAD ===
JWT_SECRET=tu_jwt_secret_muy_seguro_aqui
SETUP_SECRET=tu_setup_secret_para_migraciones

# === GOOGLE AUTH ===
GOOGLE_WEB_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=tu_android_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID_DEBUG=tu_debug_client_id.apps.googleusercontent.com

# === API KEYS ===
ESP32_API_KEY=tu_api_key_para_esp32
NEWS_API_KEY=tu_news_api_key

# === EMAIL (Recuperación de contraseña) ===
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_app_password_de_gmail

# === SERVIDOR ===
PORT=3000
